generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextIndex"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                  @id @default(cuid())
  email                 String                  @unique
  fullName              String
  role                  UserRole                @default(student)
  avatarUrl             String?                 @db.VarChar(512)
  streakDays            Int                     @default(0)
  completedLessons      Int                     @default(0)
  level                 String                  @default("A1")
  passwordHash          String                  @db.VarChar(255)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @default(now()) @updatedAt
  xpPoints              Int                     @default(0)
  courseProgress        UserCourseProgress[]
  lessonProgress        UserLessonProgress[]
  moduleProgress        UserModuleProgress[]
  words                 UserWord[]
  dictionaryViews       UserDictionaryView[]
  videoLearningProgress VideoLearningProgress[]
  videoLikes            VideoLike[]
  videoTopicPreferences VideoTopicPreference[]
  audioPhraseLevelProgress UserAudioPhraseLevelProgress[]
  audioPhraseSnippetProgress UserAudioPhraseSnippetProgress[]
  readingShelf          ReadingShelf[]
  readingProgress       ReadingProgress[]

  @@map("users")
}

model UserDictionaryView {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  query       String   @db.VarChar(200)
  word        String   @db.VarChar(255)
  translation String   @db.VarChar(255)
  lang        String   @db.VarChar(10)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, query, lang], map: "uniq_user_dictionary_view")
  @@index([userId], map: "idx_user_dictionary_view_user_id")
  @@map("user_dictionary_views")
}

model UserWord {
  id            String   @id @default(cuid())
  userId        String
  word          String   @db.VarChar(255)
  translation   String   @db.VarChar(255)
  yandexCacheId Int?     @map("yandex_cache_id")
  transcription String?  @db.VarChar(255)
  partOfSpeech  String?  @db.VarChar(64)
  audioUrl      String?  @db.VarChar(512)
  sourceLang    String   @default("en") @db.VarChar(8)
  targetLang    String   @default("ru") @db.VarChar(8)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  yandexCache   YandexDictionaryCache? @relation(fields: [yandexCacheId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@unique([userId, yandexCacheId], map: "uniq_user_yandex_cache")
  @@map("user_words")
}

model UserPreference {
  id        String   @id @default(cuid())
  userId    String   @unique(map: "userId")
  theme     String   @db.VarChar(16)
  readerFontSize Int @default(18) @map("reader_font_size")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("user_preferences")
}

model UserStreak {
  userId     String   @id
  lastSeenAt DateTime
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("user_streaks")
}

model Course {
  id               String               @id @default(cuid())
  title            String               @db.VarChar(255)
  description      String?              @db.Text
  imageUrl         String?              @db.VarChar(512)
  price            Decimal              @default(0.00) @db.Decimal(10, 2)
  difficultyLevels String               @db.VarChar(64)
  isPublished      Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @default(now()) @updatedAt
  modules          CourseModule[]
  userProgress     UserCourseProgress[]

  @@map("courses")
}

model CourseModule {
  id       String @id @default(cuid())
  courseId String
  moduleId String
  order    Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([courseId, moduleId])
  @@unique([courseId, order])
  @@index([moduleId])
  @@map("course_modules")
}

model Module {
  id           String               @id @default(cuid())
  title        String               @db.VarChar(255)
  description  String?              @db.Text
  imageUrl     String?              @db.VarChar(512)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @default(now()) @updatedAt
  courses      CourseModule[]
  lessons      ModuleLesson[]
  userProgress UserModuleProgress[]

  @@map("modules")
}

model ModuleLesson {
  id       String @id @default(cuid())
  moduleId String
  lessonId String
  order    Int
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, lessonId])
  @@unique([moduleId, order])
  @@index([lessonId])
  @@map("module_lessons")
}

model Lesson {
  id           String               @id @default(cuid())
  title        String               @db.VarChar(255)
  description  String?              @db.Text
  content      Json
  xpReward     Int                  @default(15)
  duration     Int?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @default(now()) @updatedAt
  modules      ModuleLesson[]
  userProgress UserLessonProgress[]

  @@map("lessons")
}

model UserCourseProgress {
  id          String         @id @default(cuid())
  userId      String
  courseId    String
  status      ProgressStatus @default(NOT_STARTED)
  progress    Int            @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("user_course_progress")
}

model UserModuleProgress {
  id          String         @id @default(cuid())
  userId      String
  moduleId    String
  status      ProgressStatus @default(NOT_STARTED)
  progress    Int            @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt
  module      Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([moduleId])
  @@map("user_module_progress")
}

model UserLessonProgress {
  id          String         @id @default(cuid())
  userId      String
  lessonId    String
  status      ProgressStatus @default(NOT_STARTED)
  stars       Int            @default(0)
  score       Int?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt
  lesson      Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
  @@map("user_lesson_progress")
}

model VideoLearningContent {
  id                          Int                                       @id @default(autoincrement())
  videoName                   String                                    @map("video_name") @db.VarChar(255)
  videoUrl                    String?                                   @map("video_url") @db.VarChar(500)
  cefrLevel                   VideoLearningContentCefrLevel             @map("cefr_level")
  speechSpeed                 VideoLearningContentSpeechSpeed?          @default(normal) @map("speech_speed")
  grammarComplexity           VideoLearningContentGrammarComplexity?    @default(intermediate) @map("grammar_complexity")
  vocabularyComplexity        VideoLearningContentVocabularyComplexity? @default(intermediate) @map("vocabulary_complexity")
  topics                      Json                                      @map("topics")
  transcriptFull              String                                    @map("transcript_full") @db.Text
  transcriptChunks            Json                                      @map("transcript_chunks")
  transcript_word_chunks      Json?
  transcriptTranslationFull   String?                                   @map("transcript_translation_full") @db.Text
  transcriptTranslationChunks Json?                                     @map("transcript_translation_chunks")
  exercises                   Json                                      @map("exercises")
  durationSeconds             Int?                                      @map("duration_seconds")
  audioLevel                  Float?                                    @map("audio_level")
  likesCount                  Int                                       @default(0) @map("likes_count")
  isAdultContent              Boolean?                                  @map("is_adult_content")
  isModerated                 Boolean                                   @default(false) @map("is_moderated")
  author                      String?                                   @db.VarChar(255)
  processedAt                 DateTime?                                 @default(now()) @map("processed_at") @db.Timestamp(0)
  status                      VideoLearningContentStatus?               @default(completed) @map("status")
  progressEntries             VideoLearningProgress[]
  videoTopics                 VideoTopic[]
  likes                       VideoLike[]
  transcriptTokens            VideoTranscriptToken[]
  gameSnippets                GameSnippet[]

  @@index([cefrLevel], map: "idx_cefr_level")
  @@index([processedAt], map: "idx_processed_at")
  @@index([status], map: "idx_status")
  @@index([isModerated, isAdultContent, cefrLevel, speechSpeed], map: "idx_feed_filters")
  @@index([speechSpeed], map: "idx_speech_speed")
  @@index([isAdultContent], map: "idx_adult_content")
  @@index([isModerated], map: "idx_moderated")
  @@fulltext([transcriptFull], map: "idx_transcript_full_fulltext")
  @@map("video_learning_content")
}

model VideoTranscriptToken {
  contentId       Int                  @map("content_id")
  position        Int
  token           String               @db.VarChar(128)
  tokenNormalized String               @map("token_normalized") @db.VarChar(128)
  startSeconds    Float?               @map("start_seconds")
  endSeconds      Float?               @map("end_seconds")
  content         VideoLearningContent @relation(fields: [contentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([contentId, position])
  @@index([tokenNormalized, contentId, position], map: "idx_video_transcript_token_search")
  @@map("video_transcript_tokens")
}

model Author {
  id          Int      @id @default(autoincrement())
  username    String   @unique @db.VarChar(255)
  displayName String?  @map("display_name") @db.VarChar(255)
  videoCount  Int      @default(0) @map("video_count")
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastVideoAt DateTime @default(now()) @updatedAt @map("last_video_at")

  @@map("authors")
}

model VideoTopic {
  id        Int                  @id @default(autoincrement())
  contentId Int                  @map("video_id")
  topic     String               @db.VarChar(100)
  content   VideoLearningContent @relation(fields: [contentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "video_topics_ibfk_1")

  @@index([topic], map: "idx_topic")
  @@index([contentId], map: "idx_video_id")
  @@map("video_topics")
}

model VideoLearningProgress {
  id        Int                  @id @default(autoincrement())
  userId    String               @map("user_id")
  contentId Int                  @map("content_id")
  status    VideoLearningStatus  @default(NOT_STARTED) @map("status")
  answers   Json?                @map("answers")
  score     Int?                 @map("score")
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @default(now()) @updatedAt @map("updated_at")
  content   VideoLearningContent @relation(fields: [contentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, contentId])
  @@index([contentId])
  @@index([userId, updatedAt], map: "idx_user_progress")
  @@map("video_learning_progress")
}

model VideoLike {
  id        Int                  @id @default(autoincrement())
  userId    String               @map("user_id")
  contentId Int                  @map("content_id")
  createdAt DateTime             @default(now()) @map("created_at")
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  content   VideoLearningContent @relation(fields: [contentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, contentId])
  @@index([contentId])
  @@index([userId, createdAt], map: "idx_user_likes")
  @@map("video_likes")
}

model GameSnippet {
  id           String               @id @default(cuid())
  phrase       String               @db.VarChar(255)
  translation  String?              @db.VarChar(255)
  contentId    Int                  @map("content_id")
  startSeconds Float                @map("start_seconds")
  endSeconds   Float                @map("end_seconds")
  isActive     Boolean              @default(true) @map("is_active")
  isApproved   Boolean              @default(false) @map("is_approved")
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @default(now()) @updatedAt
  content      VideoLearningContent @relation(fields: [contentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  audioPhraseLevelSnippets AudioPhraseLevelSnippet[]
  audioPhraseSnippetProgress UserAudioPhraseSnippetProgress[]

  @@index([contentId])
  @@index([phrase])
  @@map("game_snippets")
}

model AudioPhraseLevel {
  id          String                     @id @default(cuid())
  order       Int                        @unique
  xpReward    Int                        @default(0) @map("xp_reward")
  isActive    Boolean                    @default(true) @map("is_active")
  createdAt   DateTime                   @default(now()) @map("created_at")
  updatedAt   DateTime                   @default(now()) @updatedAt @map("updated_at")
  levelSnippets AudioPhraseLevelSnippet[]
  userProgress UserAudioPhraseLevelProgress[]
  snippetProgress UserAudioPhraseSnippetProgress[]

  @@map("audio_phrase_levels")
}

model AudioPhraseLevelSnippet {
  id        String          @id @default(cuid())
  levelId   String          @map("level_id")
  snippetId String          @map("snippet_id")
  order     Int?            @map("order")
  level     AudioPhraseLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)
  snippet   GameSnippet     @relation(fields: [snippetId], references: [id], onDelete: Cascade)

  @@unique([levelId, snippetId])
  @@index([snippetId])
  @@map("audio_phrase_level_snippets")
}

model UserAudioPhraseLevelProgress {
  id          String         @id @default(cuid())
  userId      String         @map("user_id")
  levelId     String         @map("level_id")
  status      ProgressStatus @default(NOT_STARTED)
  score       Int?
  startedAt   DateTime?      @map("started_at")
  completedAt DateTime?      @map("completed_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at")
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  level       AudioPhraseLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([userId, levelId])
  @@index([levelId])
  @@map("user_audio_phrase_level_progress")
}

model UserAudioPhraseSnippetProgress {
  id           String                 @id @default(cuid())
  userId       String                 @map("user_id")
  levelId      String                 @map("level_id")
  snippetId    String                 @map("snippet_id")
  exerciseType AudioPhraseExerciseType @map("exercise_type")
  isCorrect    Boolean                @map("is_correct")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @default(now()) @updatedAt @map("updated_at")
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  level        AudioPhraseLevel       @relation(fields: [levelId], references: [id], onDelete: Cascade)
  snippet      GameSnippet            @relation(fields: [snippetId], references: [id], onDelete: Cascade)

  @@unique([userId, levelId, snippetId, exerciseType], map: "uniq_user_level_snippet_exercise")
  @@index([levelId])
  @@index([snippetId])
  @@map("user_audio_phrase_snippet_progress")
}

model VideoTopicPreference {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  topic     String   @db.VarChar(100)
  likes     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, topic])
  @@index([topic])
  @@map("video_topic_preferences")
}

model video_transcriptions {
  id                Int                          @id @default(autoincrement())
  video_name        String                       @db.VarChar(255)
  video_url         String?                      @db.VarChar(500)
  transcript_full   String                       @db.Text
  transcript_chunks Json
  duration_seconds  Int?
  processed_at      DateTime?                    @default(now()) @db.Timestamp(0)
  status            video_transcriptions_status? @default(completed)

  @@index([processed_at], map: "idx_processed_at")
  @@index([status], map: "idx_status")
}

enum UserRole {
  student
  teacher
  admin
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum VideoLearningStatus {
  NOT_STARTED
  WATCHED
  COMPLETED
}

enum VideoLearningContentCefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2

  @@map("video_learning_content_cefr_level")
}

enum VideoLearningContentSpeechSpeed {
  slow
  normal
  fast

  @@map("video_learning_content_speech_speed")
}

enum VideoLearningContentGrammarComplexity {
  simple
  intermediate
  complex

  @@map("video_learning_content_grammar_complexity")
}

enum VideoLearningContentVocabularyComplexity {
  basic
  intermediate
  advanced

  @@map("video_learning_content_vocabulary_complexity")
}

enum AudioPhraseExerciseType {
  MISSING
  ASSEMBLE
  ODDWORD
  TRANSLATE
}

enum VideoLearningContentStatus {
  pending
  processing
  completed
  failed

  @@map("video_learning_content_status")
}

enum video_transcriptions_status {
  pending
  processing
  completed
  failed
}

model MuellerDictionary {
  id            Int      @id
  word          String   @db.VarChar(100)
  partOfSpeech  String?  @map("part_of_speech") @db.VarChar(50)
  translations  String   @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([word], map: "idx_mueller_word")
  @@index([partOfSpeech], map: "idx_mueller_part_of_speech")
  @@fulltext([word], map: "idx_word_fulltext")
  @@fulltext([translations], map: "idx_translations_fulltext")
  @@map("mueller_dictionary")
}

model MuellerWordIndex {
  wordNormalized String @map("word_normalized") @db.VarChar(100)
  muellerId      Int    @map("mueller_id")

  @@id([wordNormalized, muellerId])
  @@index([wordNormalized], map: "idx_word_normalized")
  @@index([muellerId], map: "idx_mueller_id")
  @@map("mueller_word_index")
}

model YandexDictionaryCache {
  id        Int      @id @default(autoincrement())
  query     String   @db.VarChar(200)
  lang      String   @db.VarChar(10)
  response  Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  userWords UserWord[]

  @@unique([query, lang], map: "uniq_yandex_query_lang")
  @@index([query], map: "idx_yandex_query")
  @@map("yandex_dictionary_cache")
}

model PhraseTranslationCache {
  id         Int      @id @default(autoincrement())
  query      String   @db.VarChar(500)
  sourceLang String   @map("source_lang") @db.VarChar(10)
  targetLang String   @map("target_lang") @db.VarChar(10)
  translation String  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([query, sourceLang, targetLang], map: "uniq_phrase_query_langs")
  @@index([query], map: "idx_phrase_query")
  @@map("phrase_translation_cache")
}

model ReadingBook {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(255)
  author      String?  @db.VarChar(255)
  description String?  @db.Text
  coverUrl    String?  @map("cover_url") @db.VarChar(512)
  fileUrl     String   @map("file_url") @db.VarChar(512)
  language    String   @default("en") @db.VarChar(16)
  cefrLevel   String?  @map("cefr_level") @db.VarChar(8)
  wordCount   Int?     @map("word_count")
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  shelfEntries ReadingShelf[]
  progressEntries ReadingProgress[]

  @@index([isPublished], map: "idx_reading_book_published")
  @@index([createdAt], map: "idx_reading_book_created_at")
  @@map("reading_books")
}

model ReadingShelf {
  id        String       @id @default(cuid())
  userId    String       @map("user_id")
  bookId    String       @map("book_id")
  createdAt DateTime     @default(now()) @map("created_at")
  book      ReadingBook  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId], map: "uniq_reading_shelf_user_book")
  @@index([userId], map: "idx_reading_shelf_user")
  @@index([bookId], map: "idx_reading_shelf_book")
  @@map("reading_shelf")
}

model ReadingProgress {
  id         String      @id @default(cuid())
  userId     String      @map("user_id")
  bookId     String      @map("book_id")
  position   Int         @default(0)
  progress   Float       @default(0)
  updatedAt  DateTime    @default(now()) @updatedAt @map("updated_at")
  book       ReadingBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId], map: "uniq_reading_progress_user_book")
  @@index([userId], map: "idx_reading_progress_user")
  @@index([bookId], map: "idx_reading_progress_book")
  @@map("reading_progress")
}
